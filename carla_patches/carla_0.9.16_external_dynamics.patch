+#pragma once
+
+#include "BaseCarlaMovementComponent.h"
+#include "Carla/Vehicle/VehicleControl.h"
+#include "ExternalDynamicsMovementComponent.generated.h"
+
+/// Vehicle state produced by an external dynamics solver, already converted
+/// to Unreal units (cm, cm/s, deg, deg/s).
+struct FVehicleExternalState
+{
+  FTransform Transform;
+  FVector Velocity = FVector::ZeroVector;
+  FVector AngularVelocity = FVector::ZeroVector;
+  TArray<float> WheelSteer;
+  TArray<float> WheelRotation;
+  TArray<float> WheelSuspension;  // cm, + = compression
+  FVehicleControl Control;
+};
+
+/// Movement component that hands the vehicle dynamics over to an external
+/// solver (e.g. CarSim running in another process or machine). PhysX vehicle
+/// simulation is disabled; every frame the client pushes the full state
+/// (pose, velocities, per-wheel steer, spin and suspension travel) which is
+/// applied kinematically.
+UCLASS(Blueprintable, meta=(BlueprintSpawnableComponent))
+class CARLA_API UExternalDynamicsMovementComponent : public UBaseCarlaMovementComponent
+{
+  GENERATED_BODY()
+
+public:
+
+  static UExternalDynamicsMovementComponent* CreateExternalDynamicsMovementComponent(
+      ACarlaWheeledVehicle* Vehicle);
+
+  /// Returns true and fills OutAngularVelocity [deg/s] if Actor is a vehicle
+  /// driven by external dynamics. Kinematic bodies report zero angular
+  /// velocity from PhysX, so sensors and snapshots must ask here instead.
+  static bool GetExternalAngularVelocity(const AActor* Actor, FVector& OutAngularVelocity);
+
+  void ApplyExternalState(const FVehicleExternalState& State);
+
+  virtual void BeginPlay() override;
+
+  virtual void ProcessControl(FVehicleControl& Control) override;
+
+  virtual FVector GetVelocity() const override;
+
+  FVector GetAngularVelocity() const { return AngularVelocity; }
+
+  virtual int32 GetVehicleCurrentGear() const override;
+
+  virtual float GetVehicleForwardSpeed() const override;
+
+  virtual void DisableSpecialPhysics() override;
+
+private:
+
+  void ApplyWheelAnimation() const;
+
+  FVector Velocity = FVector::ZeroVector;
+  FVector AngularVelocity = FVector::ZeroVector;
+  TArray<float> WheelSteer;
+  TArray<float> WheelRotation;
+  TArray<float> WheelSuspension;
+  int32 Gear = 0;
+};
