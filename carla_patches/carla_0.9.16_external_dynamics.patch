-      PhysicsWheel.TireFriction = VehicleNW->Wheels[i]->TireConfig->GetFrictionScale();
-      PhysicsWheel.Position = VehicleNW->Wheels[i]->Location;
+      // With physics off the wheel list is empty (the 4W branch above reads it
+      // only with physics on); indexing it anyway crashed multi-wheel vehicles.
+      if (i < VehicleNW->Wheels.Num() && VehicleNW->Wheels[i] != nullptr) {
+        PhysicsWheel.TireFriction = VehicleNW->Wheels[i]->TireConfig->GetFrictionScale();
+        PhysicsWheel.Position = VehicleNW->Wheels[i]->Location;
+      }
 
       Wheels.Add(PhysicsWheel);
     }
