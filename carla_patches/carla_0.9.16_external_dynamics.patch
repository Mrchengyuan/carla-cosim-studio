+ECarlaServerResponse FVehicleActor::EnableExternalDynamics()
+{
+  if (IsDormant())
+  {
+    return ECarlaServerResponse::FunctionNotAvailiableWhenDormant;
+  }
+  auto Vehicle = Cast<ACarlaWheeledVehicle>(GetActor());
+  if (Vehicle == nullptr)
+  {
+    return ECarlaServerResponse::NotAVehicle;
+  }
+  if (!Vehicle->GetCarlaMovementComponent<UExternalDynamicsMovementComponent>())
+  {
+    UExternalDynamicsMovementComponent::CreateExternalDynamicsMovementComponent(Vehicle);
+  }
+  return ECarlaServerResponse::Success;
+}
+
+ECarlaServerResponse FVehicleActor::ApplyVehicleExternalState(
+    const FVehicleExternalState& State)
+{
+  if (IsDormant())
+  {
+    // Keep the stored state moving so the actor wakes up where the external
+    // solver says it is.
+    SetActorGlobalTransform(State.Transform, ETeleportType::TeleportPhysics);
+    FActorData* ActorData = GetActorData();
+    ActorData->Velocity = State.Velocity;
+    ActorData->AngularVelocity = State.AngularVelocity;
+    return ECarlaServerResponse::Success;
+  }
+  auto Vehicle = Cast<ACarlaWheeledVehicle>(GetActor());
+  if (Vehicle == nullptr)
+  {
+    return ECarlaServerResponse::NotAVehicle;
+  }
+  auto* Component =
+      Vehicle->GetCarlaMovementComponent<UExternalDynamicsMovementComponent>();
+  if (!Component)
+  {
+    return ECarlaServerResponse::ExternalDynamicsNotEnabled;
+  }
+  SetActorGlobalTransform(State.Transform, ETeleportType::TeleportPhysics);
+  Component->ApplyExternalState(State);
+  return ECarlaServerResponse::Success;
+}
