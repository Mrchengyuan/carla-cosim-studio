+      return RespondError(
+          "apply_vehicle_external_state",
+          ECarlaServerResponse::ActorNotFound,
+          " Actor Id: " + FString::FromInt(ActorId));
+    }
+    FVehicleExternalState State;
+    State.Transform = InState.transform;
+    State.Velocity = InState.velocity.ToCentimeters().ToFVector();
+    State.AngularVelocity = InState.angular_velocity.ToFVector();
