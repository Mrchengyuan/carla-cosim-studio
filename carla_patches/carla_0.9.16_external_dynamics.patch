+#include "carla/geom/Vector3D.h"
+
+#include <vector>
+
+namespace carla {
+namespace rpc {
+
+  /// Full kinematic state of a vehicle computed by an external dynamics
+  /// solver (e.g. CarSim). Applied atomically on the server in a single call,
+  /// so that body pose, velocities and wheel animation stay consistent within
+  /// the same simulation frame.
+  ///
+  /// All quantities are expressed in CARLA conventions: meters, degrees,
+  /// left-handed world frame (x forward, y right, z up).
+  class VehicleExternalState {
+  public:
+
+    VehicleExternalState() = default;
+
+    /// Actor transform (actor origin, not the CarSim sprung-mass origin).
+    geom::Transform transform;
+
+    /// Linear velocity in world frame [m/s].
+    geom::Vector3D velocity;
+
+    /// Angular velocity in world frame [deg/s].
+    geom::Vector3D angular_velocity;
+
+    /// Road-wheel steer angle per wheel [deg], ordered FL, FR, RL, RR, ...
+    /// Positive values steer to the right (CARLA convention).
+    std::vector<float> wheel_steer;
+
+    /// Accumulated wheel spin (pitch) angle per wheel [deg], same order.
+    std::vector<float> wheel_rotation;
+
+    /// Suspension travel per wheel relative to the design position [m],
+    /// positive = compression (wheel moves up towards the body), same order.
+    std::vector<float> wheel_suspension;
+
+    /// Driver inputs reported back through Vehicle.get_control().
+    float throttle = 0.0f;
+    float steer = 0.0f;
+    float brake = 0.0f;
+    int32_t gear = 0;
+
+    MSGPACK_DEFINE_ARRAY(
+        transform,
+        velocity,
+        angular_velocity,
+        wheel_steer,
+        wheel_rotation,
+        wheel_suspension,
+        throttle,
+        steer,
+        brake,
+        gear);
+  };
+
+} // namespace rpc
+} // namespace carla
