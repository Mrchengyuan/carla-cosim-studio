+  void Client::ApplyVehicleExternalState(
+      rpc::ActorId vehicle,
+      const rpc::VehicleExternalState &state) {
+    // Blocking on purpose: the server handles RPCs on several threads, so a
+    // fire-and-forget call can land after the following tick() and show up
+    // one frame late. Co-simulation needs the state in exactly this frame.
+    _pimpl->CallAndWait<void>("apply_vehicle_external_state", vehicle, state);
+  }
