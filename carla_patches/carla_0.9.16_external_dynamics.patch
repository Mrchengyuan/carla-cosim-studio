+// Copyright (c) 2026 Computer Vision Center (CVC) at the Universitat Autonoma
+// de Barcelona (UAB).
+//
+// This work is licensed under the terms of the MIT license.
+// For a copy, see <https://opensource.org/licenses/MIT>.
+
+#include "ExternalDynamicsMovementComponent.h"
+#include "DefaultMovementComponent.h"
+#include "Carla/Vehicle/CarlaWheeledVehicle.h"
+#include "VehicleAnimInstance.h"
+
+#include <compiler/disable-ue4-macros.h>
+#include <carla/Logging.h>
+#include <compiler/enable-ue4-macros.h>
+
+UExternalDynamicsMovementComponent*
+UExternalDynamicsMovementComponent::CreateExternalDynamicsMovementComponent(
+    ACarlaWheeledVehicle* Vehicle)
+{
+  // PhysX vehicle simulation can only be switched off from the default
+  // movement component, so fall back to it first if another special physics
+  // backend (CarSim plugin, Chrono, ...) is currently active.
+  if (!Vehicle->GetCarlaMovementComponent<UDefaultMovementComponent>())
+  {
+    UBaseCarlaMovementComponent* Current = Vehicle->GetCarlaMovementComponent();
+    if (Current)
+    {
+      Current->DisableSpecialPhysics();
+    }
+  }
+  // Destroys the PhysX vehicle state and makes the root body kinematic. From
+  // here on the vehicle anim instance uses the custom wheel rotations we set.
+  Vehicle->SetSimulatePhysics(false);
+
+  UExternalDynamicsMovementComponent* Component =
+      NewObject<UExternalDynamicsMovementComponent>(Vehicle);
+  Vehicle->SetCarlaMovementComponent(Component);
+  Component->RegisterComponent();
+  return Component;
+}
+
+bool UExternalDynamicsMovementComponent::GetExternalAngularVelocity(
+    const AActor* Actor, FVector& OutAngularVelocity)
+{
+  const ACarlaWheeledVehicle* Vehicle = Cast<ACarlaWheeledVehicle>(Actor);
+  if (!Vehicle)
+  {
+    return false;
+  }
+  const UExternalDynamicsMovementComponent* Component =
+      Vehicle->GetCarlaMovementComponent<UExternalDynamicsMovementComponent>();
+  if (!Component)
+  {
+    return false;
+  }
+  OutAngularVelocity = Component->GetAngularVelocity();
+  return true;
+}
+
+void UExternalDynamicsMovementComponent::BeginPlay()
+{
+  Super::BeginPlay();
+}
+
+void UExternalDynamicsMovementComponent::ApplyExternalState(
+    const FVehicleExternalState& State)
+{
+  // The transform itself is applied by FVehicleActor so that large-map
+  // global/local conversion and dormant actors are handled in one place.
+  Velocity = State.Velocity;
+  AngularVelocity = State.AngularVelocity;
+  WheelSteer = State.WheelSteer;
+  WheelRotation = State.WheelRotation;
+  WheelSuspension = State.WheelSuspension;
+  Gear = State.Control.Gear;
+
+  ApplyWheelAnimation();
+
+  if (CarlaVehicle)
+  {
+    // Report the external solver's driver inputs through get_control().
+    CarlaVehicle->ApplyVehicleControl(State.Control, EVehicleInputPriority::Client);
+  }
+}
+
+void UExternalDynamicsMovementComponent::ApplyWheelAnimation() const
+{
+  if (!CarlaVehicle)
+  {
+    return;
+  }
+  UVehicleAnimInstance* VehicleAnim =
+      Cast<UVehicleAnimInstance>(CarlaVehicle->GetMesh()->GetAnimInstance());
+  if (!VehicleAnim)
+  {
+    return;
+  }
+  // Never index past the wheels the vehicle blueprint actually has.
+  const int32 NumWheels =
+      CarlaVehicle->GetVehicleMovementComponent()->WheelSetups.Num();
+
+  for (int32 i = 0; i < NumWheels; ++i)
+  {
+    // SetWheelRotYaw also switches the anim proxy to custom wheel data, so it
+    // is called for every wheel even without a steer value; otherwise pitch
+    // and height would be ignored.
+    VehicleAnim->SetWheelRotYaw(
+        static_cast<uint8>(i), WheelSteer.IsValidIndex(i) ? WheelSteer[i] : 0.f);
+    if (WheelRotation.IsValidIndex(i))
+    {
+      VehicleAnim->SetWheelPitchAngle(static_cast<uint8>(i), WheelRotation[i]);
+    }
+#ifdef PHYSXVEHICLES_HAS_SET_PITCH_HEIGHT
+    // CARLA's UE4 fork: offset applied to the wheel bone translation, the
+    // same channel PhysX suspension jounce drives when physics is on.
+    if (WheelSuspension.IsValidIndex(i))
+    {
+      VehicleAnim->SetWheelHeight(static_cast<uint8>(i), WheelSuspension[i]);
+    }
+#endif
+  }
+}
+
+void UExternalDynamicsMovementComponent::ProcessControl(FVehicleControl& Control)
+{
+  // Driver inputs go to the external solver, not to UE. Only keep the gear
+  // consistent with what the solver reported.
+  Control.Gear = Gear;
+}
+
+FVector UExternalDynamicsMovementComponent::GetVelocity() const
+{
+  return Velocity;
+}
+
+int32 UExternalDynamicsMovementComponent::GetVehicleCurrentGear() const
+{
+  return Gear;
+}
+
+float UExternalDynamicsMovementComponent::GetVehicleForwardSpeed() const
+{
+  if (!CarlaVehicle)
+  {
+    return 0.f;
+  }
+  return FVector::DotProduct(Velocity, CarlaVehicle->GetActorForwardVector());
+}
+
+void UExternalDynamicsMovementComponent::DisableSpecialPhysics()
+{
+  if (!CarlaVehicle)
+  {
+    return;
+  }
+  // Keep local copies: creating the default component destroys this one.
+  ACarlaWheeledVehicle* Vehicle = CarlaVehicle;
+  const FVector LastVelocity = Velocity;
+  const FVector LastAngularVelocity = AngularVelocity;
+
+  UDefaultMovementComponent::CreateDefaultMovementComponent(Vehicle);
+  Vehicle->SetSimulatePhysics(true);
+  // Restoring the physics control re-creates the PhysX vehicle, which resets
+  // its velocity, so it must come before the velocity hand-over.
+  Vehicle->RestoreVehiclePhysicsControl();
+  // Hand over with the last external velocities so the car does not stop dead.
+  Vehicle->GetMesh()->SetPhysicsLinearVelocity(LastVelocity);
+  Vehicle->GetMesh()->SetPhysicsAngularVelocityInDegrees(LastAngularVelocity);
+}
